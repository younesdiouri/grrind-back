# Valeurs par défaut, non sensibles, versionnées.
#
# Ce fichier est chargé en premier, puis surchargé dans cet ordre :
#
#  * .env.local          non versionné — les valeurs réelles du poste de dev (`make secrets`)
#  * .env.$APP_ENV       versionné — défauts spécifiques à un environnement
#  * .env.$APP_ENV.local non versionné
#
# Les vraies variables d'environnement gagnent toujours.
#
# AUCUN SECRET ICI. Une valeur secrète se génère avec `make secrets` (poste de dev) ou
# se fournit par l'environnement / un secret monté (prod). Tout ce qui est laissé vide
# ci-dessous DOIT être renseigné ailleurs — c'est volontaire, pas un oubli.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
GAME_IMAGES_DIR=%kernel.project_dir%/var/game-images
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="postgresql://grrind:grrind@database:5432/grrind?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Les clés sont générées par `make jwt-keys` et ne sont jamais versionnées ; en prod
# elles viennent d'un secret monté, avec sa propre passphrase.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
# 15 minutes : le client rafraîchit avant expiration, il ne subit pas de 401.
JWT_TTL=900
###< lexik/jwt-authentication-bundle ###

###> knpuniversity/oauth2-client-bundle ###
# Social sign-in. Les identifiants d'application ne sont pas des secrets de build :
# ils viennent de .env.local en dev et de l'environnement en prod. Vides ici, le
# conteneur démarre quand même — seul un appel à /api/auth/social/… échouerait.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Le schéma d'URL de l'app iOS. Le client renvoie le sien à chaque requête ; cette
# valeur ne sert que de repli.
GOOGLE_REDIRECT_URI=app.grrind://auth/google

# Apple ne délivre pas de secret client : il se signe à chaque échange avec la clé
# privée .p8 téléchargée depuis le portail développeur. Elle n'est jamais versionnée
# et n'entre pas dans l'image — en prod elle arrive par un secret monté.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_FILE_ID=
APPLE_KEY_FILE_PATH=%kernel.project_dir%/config/apple/AuthKey.p8
APPLE_REDIRECT_URI=app.grrind://auth/apple
###< knpuniversity/oauth2-client-bundle ###

###> symfony/messenger ###
# La même connexion que les entités, et c'est tout l'intérêt : l'événement est écrit
# dans la transaction qui écrit le fait. `auto_setup=0` parce que le schéma vient d'une
# migration relue, jamais d'une création au vol — la règle vaut aussi pour les tables
# que nous n'écrivons pas nous-mêmes.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/expo-notifier ###
# Le défaut non sensible est « journal seulement » : `null://null` ne part jamais sur le
# réseau. Un poste de dev qui veut pousser vers un vrai téléphone surcharge cette valeur
# dans .env.local avec un vrai jeton Expo — jamais ici. L'environnement `test`, lui, la
# force à `null://null` sans condition dans config/packages/notifier.yaml : aucune suite
# PHPUnit ne doit pouvoir appeler Expo, même si le poste a un vrai jeton configuré.
EXPO_DSN=null://null
###< symfony/expo-notifier ###

###> app/push-target-environment ###
# Quel canal APNs ce déploiement adresse (#149) — `DEVELOPMENT` ou `PRODUCTION`, voir
# `App\Identity\Domain\DeviceEnvironment`. `PRODUCTION` est le seul défaut vrai : tout
# build EAS (client de dev en `distribution: internal`, preview, TestFlight, App Store)
# produit un jeton `PRODUCTION`. Seul un `expo run:ios` local signé par un profil de
# développement produit `DEVELOPMENT`, et ce cas se surcharge dans .env.local — jamais
# ici. Ce réglage ne dit rien sur `%kernel.environment%` : un back de dev qui vise
# `PRODUCTION` est la combinaison normale, pas une anomalie à corriger.
PUSH_TARGET_ENVIRONMENT=PRODUCTION
###< app/push-target-environment ###
