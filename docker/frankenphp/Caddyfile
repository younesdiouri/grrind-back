{
    {$CADDY_GLOBAL_OPTIONS}
    frankenphp {
        {$FRANKENPHP_CONFIG}
    }
}

{$SERVER_NAME:localhost} {
    root * /app/public
    encode zstd br gzip

    # Le hub partage la machine web, mais l'outbox le joint par HTTP depuis le worker.
    # Aucun abonné anonyme ; un JWT ne permet que les topics qui lui ont été accordés.
    # Mode moderne (#310) : l'issuer doit valoir le `iss` de config/packages/mercure.yaml.
    # resource_identifier épingle l'audience : l'outbox publie par une URL interne qui n'est pas
    # celle de l'abonné, et le hub déduirait sinon une audience différente pour chacun.
    mercure {
        issuer grrind-back {
            publisher {
                jwt {$MERCURE_JWT_SECRET} HS256
            }
            subscriber {
                jwt {$MERCURE_JWT_SECRET} HS256
            }
        }
        resource_identifier {$MERCURE_PUBLIC_URL}
    }

    # Le plafond applicatif d'image est inférieur ; borne aussi le corps avant PHP.
    @chat path /api/guilds/*/chat/messages
    request_body @chat {
        max_size 7MB
    }
    php_server
}
