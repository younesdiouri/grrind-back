<div class="table-scroll"><table><caption>Profils fictifs du lot — équipement vide, aucun compte de jeu</caption><thead><tr><th>Profil</th><th>Force</th><th>Endurance</th><th>Mobilité</th><th>Dextérité</th><th>Total</th><th>Répartition</th></tr></thead><tbody>
{% for profile in profiles %}{% set total = profile.strength + profile.endurance + profile.mobility + profile.dexterity %}<tr><th scope="row">{{ profile.name }}</th><td>{{ profile.strength }}</td><td>{{ profile.endurance }}</td><td>{{ profile.mobility }}</td><td>{{ profile.dexterity }}</td><td>{{ total }}</td><td><div class="attribute-bar" aria-hidden="true">{% for key,color in {strength:'#ffb86c',endurance:'#70d6c4',mobility:'#88aaff',dexterity:'#d7a7ef'} %}<span style="width:{{ 100 * attribute(profile,key) / total }}%;background:{{ color }}"></span>{% endfor %}</div></td></tr>{% endfor %}
</tbody></table></div>
