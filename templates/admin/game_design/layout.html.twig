<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Atelier de game design · GRRIND{% endblock %}</title>
    <style>
        :root{font-family:system-ui,sans-serif;color:#e6edf3;background:#101820;color-scheme:dark}body{max-width:1200px;margin:0 auto;padding:24px}a{color:#70d6c4}nav{display:flex;gap:24px;margin-bottom:32px}h1{font-size:2rem}h2{margin-top:32px}p{line-height:1.6;color:#bbcad6}table{border-collapse:collapse;width:100%;margin:20px 0}td,th{padding:12px;text-align:left;border-bottom:1px solid #34414d;vertical-align:top;overflow-wrap:anywhere}th{color:#9db6c7}button,.button{background:#70d6c4;color:#101820;border:0;border-radius:6px;padding:12px 20px;font-weight:600;cursor:pointer;display:inline-block}input,select,textarea{padding:10px;background:#192530;border:1px solid #516676;border-radius:4px;max-width:100%;box-sizing:border-box}label{display:block;margin:12px 0 6px}ul{line-height:1.7}.error{color:#ffb4b4;background:#402b30;padding:16px}.success{background:#174238;padding:16px}.panel{background:#192530;padding:24px;border-radius:8px;margin:20px 0}.table-scroll{overflow-x:auto}.attribute-bar{display:flex;min-width:130px;height:14px;border-radius:4px;overflow:hidden}.bar-track{height:12px;background:#293c4a;min-width:150px;margin:5px 0}.bar-fill{height:100%}.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}.kpi{background:#192530;border-radius:8px;padding:20px}.kpi strong{font-size:1.6rem;display:block}.heatmap td{min-width:160px}.heatmap small{display:block}.campaign-cta{border:1px solid #70d6c4}nav{flex-wrap:wrap}figure{margin:0}.comparison-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}.chart{width:100%;height:auto}pre{white-space:pre-wrap;overflow-wrap:anywhere}.muted{color:#9db6c7}
    </style>
</head>
<body>
{% set statLabels = {hp: 'Points de vie', damage: 'Dégâts', mitigationPermille: 'Réduction des dégâts (‰)', comboPermille: 'Combo (‰)', dodgePermille: 'Esquive (‰)', maintenancePermille: 'Maintien (‰)', criticalChancePermille: 'Critique (‰)', guardPermille: 'Garde (‰)', criticalResistancePermille: 'Résistance critique (‰)', cooldownReductionPermille: 'Réduction du délai (‰)', precisionPermille: 'Précision (‰)', strength: 'Force', endurance: 'Endurance', mobility: 'Mobilité', dexterity: 'Dextérité', vitality: 'Vitalité'} %}

<nav><a href="{{ path('admin') }}">Administration</a><a href="{{ path('admin_game_design') }}">Game design</a><a href="{{ path('admin_game_design_profiles') }}">Profils et expériences</a><a href="{{ path('admin_game_design_campaigns') }}">Campagnes d’équilibrage</a></nav>
{% for message in app.flashes('success') %}<p class="success" role="status">{{ message }}</p>{% endfor %}
{% block body %}{% endblock %}
</body>
</html>
